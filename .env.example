# Get these from https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret

# Optional overrides (defaults shown)
# ASSET_CLASS=stocks            # or crypto
# SYMBOLS=SPY,QQQ               # crypto default: BTC/USD,ETH/USD
# BAR_MINUTES=1
# FAST_EMA=9
# SLOW_EMA=21
# TREND_EMA=0                   # e.g. 200 to only buy above the long-term trend
# EXIT_ON_TREND=1               # 0 = exit only on stop loss / take profit
# STOP_LOSS_PCT=0.0075
# TAKE_PROFIT_PCT=0.015
# POSITION_NOTIONAL_USD=1000
# MAX_DAILY_LOSS_USD=150
# MAX_TRADES_PER_DAY=12
# FEE_PCT=0.0002                # crypto default: 0.0025

# Phone alerts: install the ntfy app and subscribe to this (hard-to-guess) topic
# NTFY_TOPIC=
